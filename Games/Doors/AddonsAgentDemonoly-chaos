	local function CreateStairwellWorkspaceESP(ToggleKey, ColorKey, Label, Matcher)
		local Tracked = {}
		local Connections = {}

		local function RemoveESPObject(Object)
			if Tracked[Object] then
				ESPLibrary:RemoveESP(Object)
				Tracked[Object] = nil
			end
		end

		local function ResolveTarget(Object)
			if Object:IsA("BasePart") or Object:IsA("Model") then
				return Object
			end
			local Parent = Object.Parent
			if Parent and (Parent:IsA("BasePart") or Parent:IsA("Model")) then
				return Parent
			end
			return nil
		end

		local function AddESPObject(Object)
			local Target = ResolveTarget(Object)
			if not Target or Tracked[Target] then return end
			Tracked[Target] = true
			ESPLibrary:AddESP({
				Object = Target,
				Text = Label,
				Color = Options[ColorKey].Value
			})
			Target.Destroying:Once(function()
				RemoveESPObject(Target)
			end)
		end

		local function Scan()
			for _, Object in ipairs(workspace:GetDescendants()) do
				if Matcher(Object) then
					AddESPObject(Object)
				end
			end
		end

		local function Clear()
			for Object in pairs(Tracked) do
				RemoveESPObject(Object)
			end
		end

		Toggles[ToggleKey]:OnChanged(function(Value)
			if Value then
				Scan()
				table.insert(Connections, workspace.DescendantAdded:Connect(function(Object)
					if Toggles[ToggleKey].Value and Matcher(Object) then
						AddESPObject(Object)
					end
				end))
				table.insert(Connections, workspace.DescendantRemoving:Connect(function(Object)
					local Matched = Matcher(Object)
					RemoveESPObject(Object)
					if Matched and Object.Parent then
						RemoveESPObject(Object.Parent)
					end
				end))
			else
				Clear()
				for _, Connection in ipairs(Connections) do
					Connection:Disconnect()
				end
				table.clear(Connections)
			end
		end)

		Options[ColorKey]:OnChanged(function(Value)
			for Object in pairs(Tracked) do
				ESPLibrary:UpdateObjectColor(Object, Value)
			end
		end)
	end

	local function CreakESPMatcher(Object)
		if Object.Name ~= "Creak" then return false end
		local LiveEntities = workspace:FindFirstChild("LiveEntities")
		return LiveEntities ~= nil and Object:IsDescendantOf(LiveEntities)
	end

	local function SpikeWallESPMatcher(Object)
		if Object.Name ~= "Crush" and Object.Name ~= "Crusher" then return false end
		local CurrentRoomsFolder = workspace:FindFirstChild("CurrentRooms")
		return CurrentRoomsFolder ~= nil and Object:IsDescendantOf(CurrentRoomsFolder)
	end

	local function TVStandESPMatcher(Object)
		return Object.Name == "TV_Stand"
	end

