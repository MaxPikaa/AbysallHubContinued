	local GrinderDepotESPObjects = {}
	local GrinderDepotConnections = {}

	local function RemoveGrinderDepotESP(object)
		if GrinderDepotESPObjects[object] then
			ESPLibrary:RemoveESP(object)
			GrinderDepotESPObjects[object] = nil
		end
	end

	local function AddGrinderDepotESP(object)
		if GrinderDepotESPObjects[object] then return end
		GrinderDepotESPObjects[object] = true
		ESPLibrary:AddESP({
			Object = object,
			Text = "Stairwell Scrapper",
			Color = Options.VoidAddon_GrinderDepotESPColor.Value
		})
		object.Destroying:Once(function()
			RemoveGrinderDepotESP(object)
		end)
	end

	local function ScanGrinderDepot()
		local rooms = workspace:FindFirstChild("CurrentRooms")
		if not rooms then return end
		for _, object in ipairs(rooms:GetDescendants()) do
			if object:IsA("Model") and object.Name == "StairwellScrapper" then
				AddGrinderDepotESP(object)
			end
		end
	end

	local function ClearGrinderDepot()
		for object in pairs(GrinderDepotESPObjects) do RemoveGrinderDepotESP(object) end
	end

	Toggles.VoidAddon_GrinderDepotESP:OnChanged(function(value)
		if value then
			ScanGrinderDepot()
			local rooms = workspace:FindFirstChild("CurrentRooms")
			if rooms then
				table.insert(GrinderDepotConnections, rooms.DescendantAdded:Connect(function(object)
					if Toggles.VoidAddon_GrinderDepotESP.Value and object:IsA("Model") and object.Name == "StairwellScrapper" then
						AddGrinderDepotESP(object)
					end
				end))
				table.insert(GrinderDepotConnections, rooms.DescendantRemoving:Connect(function(object)
					RemoveGrinderDepotESP(object)
				end))
			end
		else
			ClearGrinderDepot()
			for _,connection in ipairs(GrinderDepotConnections) do connection:Disconnect() end
			table.clear(GrinderDepotConnections)
		end
	end)

	Options.VoidAddon_GrinderDepotESPColor:OnChanged(function(Value)
